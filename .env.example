# =====================================================
# wohn-watch — environment configuration
# Copy to .env for local runs; paste into Coolify for deploy.
# =====================================================

# -- Telegram -------------------------------------------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# -- inberlinwohnen.de ----------------------------------
# One shared account; every user of the bot is served from this login.
BERLIN_WOHNEN_USERNAME=
BERLIN_WOHNEN_PASSWORD=

# -- Tuning ---------------------------------------------
# How often to poll the Wohnungsfinder, in seconds.
SCRAPE_INTERVAL_SECONDS=60
# Listings older than this are pruned so the volume stays bounded.
FLAT_RETENTION_DAYS=30
# Where the SQLite database lives (a Docker volume in production).
DATA_DIR=/data
LOG_LEVEL=INFO
